# Salin file ini menjadi .env lalu jalankan: docker compose up -d --build
# User & password layanan di bawah adalah nilai DEMO yang sama dengan database/init.sql.
MYSQL_ROOT_PASSWORD=ganti_dengan_password_root
AUTH_DB_USER=user_auth
AUTH_DB_PASSWORD=authTani2026
LAHAN_DB_USER=user_lahan
LAHAN_DB_PASSWORD=lahanTani2026
PANEN_DB_USER=user_panen
PANEN_DB_PASSWORD=panenTani2026
PENJUALAN_DB_USER=user_penjualan
PENJUALAN_DB_PASSWORD=jualTani2026
# Kunci tanda tangan token login: isi dengan teks acak panjang
JWT_SECRET=ganti_dengan_teks_acak_panjang
